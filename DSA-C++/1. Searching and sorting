#include <iostream>
#include <cstdlib>
#include <cstring>
#include <chrono>
using namespace std;
using namespace std::chrono;

struct Student
{
    int id;
    char name[30];
    float cgpa;
};

int main()
{
    Student *s = NULL;
    int n;

    cout << "Enter number of students: ";
    cin >> n;

    // Dynamic Memory Allocation
    for(int i = 0; i < n; i++)
    {
        s = (Student*)realloc(s, (i + 1) * sizeof(Student));

        cout << "\nEnter Student " << i + 1 << " details:\n";

        cout << "Enter ID: ";
        cin >> s[i].id;

        cout << "Enter Name: ";
        cin >> s[i].name;

        cout << "Enter CGPA: ";
        cin >> s[i].cgpa;
    }

    // Display Students
    cout << "\n--- Student Records ---\n";
    cout << "ID\tName\tCGPA\n";

    for(int i = 0; i < n; i++)
    {
        cout << s[i].id << "\t"
             << s[i].name << "\t"
             << s[i].cgpa << endl;
    }

    // ---------------- LINEAR SEARCH ----------------

    int key, pos = -1;

    cout << "\nEnter ID for Linear Search: ";
    cin >> key;

    auto start = high_resolution_clock::now();

    for(int i = 0; i < n; i++)
    {
        if(s[i].id == key)
        {
            pos = i;
            break;
        }
    }

    auto stop = high_resolution_clock::now();

    if(pos != -1)
        cout << "Linear Search: Record Found\n";
    else
        cout << "Linear Search: Record Not Found\n";

    auto linearTime =
        duration_cast<nanoseconds>(stop - start);

    // ---------------- BUBBLE SORT BY NAME ----------------

    for(int i = 0; i < n - 1; i++)
    {
        for(int j = 0; j < n - i - 1; j++)
        {
            if(strcmp(s[j].name, s[j + 1].name) > 0)
            {
                Student temp = s[j];
                s[j] = s[j + 1];
                s[j + 1] = temp;
            }
        }
    }

    cout << "\n--- Sorted by Name ---\n";
    cout << "ID\tName\tCGPA\n";

    for(int i = 0; i < n; i++)
    {
        cout << s[i].id << "\t"
             << s[i].name << "\t"
             << s[i].cgpa << endl;
    }

    // ---------------- SELECTION SORT BY CGPA ----------------

    for(int i = 0; i < n - 1; i++)
    {
        int minIndex = i;

        for(int j = i + 1; j < n; j++)
        {
            if(s[j].cgpa < s[minIndex].cgpa)
                minIndex = j;
        }

        Student temp = s[i];
        s[i] = s[minIndex];
        s[minIndex] = temp;
    }

    cout << "\n--- Sorted by CGPA ---\n";
    cout << "ID\tName\tCGPA\n";

    for(int i = 0; i < n; i++)
    {
        cout << s[i].id << "\t"
             << s[i].name << "\t"
             << s[i].cgpa << endl;
    }

    // ---------------- SORT BY ID FOR BINARY SEARCH ----------------

    for(int i = 0; i < n - 1; i++)
    {
        for(int j = 0; j < n - i - 1; j++)
        {
            if(s[j].id > s[j + 1].id)
            {
                Student temp = s[j];
                s[j] = s[j + 1];
                s[j + 1] = temp;
            }
        }
    }

    // ---------------- BINARY SEARCH ----------------

    pos = -1;

    start = high_resolution_clock::now();

    int low = 0;
    int high = n - 1;

    while(low <= high)
    {
        int mid = (low + high) / 2;

        if(s[mid].id == key)
        {
            pos = mid;
            break;
        }
        else if(key < s[mid].id)
        {
            high = mid - 1;
        }
        else
        {
            low = mid + 1;
        }
    }

    stop = high_resolution_clock::now();

    if(pos != -1)
        cout << "\nBinary Search: Record Found\n";
    else
        cout << "\nBinary Search: Record Not Found\n";

    auto binaryTime =
        duration_cast<nanoseconds>(stop - start);

    // ---------------- PERFORMANCE ----------------

    cout << "\n--- Search Performance ---\n";

    cout << "Linear Search : "
         << linearTime.count()
         << " ns\n";

    cout << "Binary Search : "
         << binaryTime.count()
         << " ns\n";

    // Free Memory
    free(s);

    return 0;
}