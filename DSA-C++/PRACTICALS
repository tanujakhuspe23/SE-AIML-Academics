#include <iostream>
#include <cstdlib>
#include <cstring>
#include <chrono>
using namespace std;
using namespace std::chrono;

struct Student
{
    int id;
    char name[30];
    float cgpa;
};

int main()
{
    Student *s = NULL;
    int n;

    cout << "Enter number of students: ";
    cin >> n;

    // Dynamic memory
    for(int i = 0; i < n; i++)
    {
        s = (Student*)realloc(s, (i + 1) * sizeof(Student));

        cout << "\nEnter ID, Name, CGPA: ";
        cin >> s[i].id >> s[i].name >> s[i].cgpa;
    }

    // Display
    cout << "\nID\tName\tCGPA\n";
    for(int i = 0; i < n; i++)
        cout << s[i].id << "\t" << s[i].name << "\t"
             << s[i].cgpa << endl;

    // Linear Search
    int key, pos = -1;
    cout << "\nEnter ID for Linear Search: ";
    cin >> key;

    auto start = high_resolution_clock::now();

    for(int i = 0; i < n; i++)
    {
        if(s[i].id == key)
        {
            pos = i;
            break;
        }
    }

    auto stop = high_resolution_clock::now();

    if(pos != -1)
        cout << "Record Found\n";
    else
        cout << "Record Not Found\n";

    auto linearTime = duration_cast<nanoseconds>(stop - start);

    // Bubble Sort by Name
    for(int i = 0; i < n-1; i++)
        for(int j = 0; j < n-i-1; j++)
            if(strcmp(s[j].name, s[j+1].name) > 0)
                swap(s[j], s[j+1]);

    cout << "\nSorted by Name:\n";
    for(int i = 0; i < n; i++)
        cout << s[i].id << "\t" << s[i].name << "\t"
             << s[i].cgpa << endl;

    // Selection Sort by CGPA
    for(int i = 0; i < n-1; i++)
    {
        int min = i;

        for(int j = i+1; j < n; j++)
            if(s[j].cgpa < s[min].cgpa)
                min = j;

        swap(s[i], s[min]);
    }

    cout << "\nSorted by CGPA:\n";
    for(int i = 0; i < n; i++)
        cout << s[i].id << "\t" << s[i].name << "\t"
             << s[i].cgpa << endl;

    // Sort by ID for Binary Search
    for(int i = 0; i < n-1; i++)
        for(int j = 0; j < n-i-1; j++)
            if(s[j].id > s[j+1].id)
                swap(s[j], s[j+1]);

    // Binary Search
    pos = -1;
    start = high_resolution_clock::now();

    int low = 0, high = n-1;

    while(low <= high)
    {
        int mid = (low + high) / 2;

        if(s[mid].id == key)
        {
            pos = mid;
            break;
        }
        else if(key < s[mid].id)
            high = mid - 1;
        else
            low = mid + 1;
    }

    stop = high_resolution_clock::now();

    if(pos != -1)
        cout << "\nBinary Search: Record Found\n";
    else
        cout << "\nBinary Search: Record Not Found\n";
